# Copiá este archivo a .env.local y completá los valores.

# --- Supabase (proyecto de viajes) ---
NEXT_PUBLIC_SUPABASE_URL=https://[..].supabase.co
# Clave PÚBLICA (publishable / anon).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Clave SECRETA (service_role). Solo servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# URL pública donde corre la app
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app
# Número de soporte para los links de WhatsApp
SOPORTE_WHATSAPP=5491100000000

# --- Resend (emails) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Viajes Filial <avisos@tallerescapfed.com.ar>
RESEND_REPLY_TO=

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=
# Firma secreta del webhook (Tus integraciones > Webhooks).
MERCADOPAGO_WEBHOOK_SECRET=

# --- Cron ---
# OBLIGATORIA para usar /api/cron/*. Generá una larga y aleatoria:
#   openssl rand -hex 32
CRON_SECRET=

# --- Handoff con el portal de socios ---
NEXT_PUBLIC_LOGIN_SOCIOS_URL=https://socios.dominio.com/login
SOCIOS_SUPABASE_URL=https://segundo-proyecto.supabase.co
SOCIOS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
